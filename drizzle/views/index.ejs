<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>URL</title>
</head>
<body>
     <%- include('./partials/header') %> <% if(user) { %>
        <h2>You Are Looged In</h2>
        <%}else{ %>
            <h2>You are not Logged In</h2>

       <% } %>




    <section class="main-section">
    <div class="container">

        <h1>URL Shortener</h1>

        <form id="shorten-form" action="/" method="post">

            <div class="input-box">
                <i class="fa-solid fa-link"></i>
                <input 
                    type="url" 
                    name="url"
                    placeholder="Enter URL"
                    required
                >
            </div>


            <div class="input-box">
                <i class="fa-solid fa-code"></i>
                <input 
                    type="text" 
                    name="shortCode"
                    placeholder="Enter custom short code"
                    required
                >
            </div>


            <button type="submit">
                Shorten
            </button>

        </form>


        <h2>Shortened URLs</h2>

        <div class="urls">

            <ul id="shortened-urls">

            <% links.forEach((link) => { %>

                <li>

                    <div class="url-data">

                        <a href="/<%= link.shortCode %>" target="_blank">
                            <i class="fa-solid fa-link"></i>
                            <%= host %>/<%= link.shortCode %>
                        </a>

                        <p>
                            <%= link.url %>
                        </p>

                    </div>


                    <i class="fa-regular fa-copy copy-icon"></i>

                </li>

            <% }) %>

            </ul>

        </div>

    </div>
</section>
     <%- include('./partials/footer') %>
    
    
</body>
</html>